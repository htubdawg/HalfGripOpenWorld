<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the traffic's room (TrafficRoom.cs: who drives each physics car, the ledger, the clock, the stand-ins' playback) on pretend machines over a pretend network. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../OpenWorld/src/TrafficRoom.cs" />
  </ItemGroup>
</Project>
