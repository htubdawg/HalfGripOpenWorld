<Project Sdk="Microsoft.NET.Sdk">
  <!-- The traffic rework's checks, headless (docs/TRAFFIC_REWORK.md, section 5). Phase 2: each race's plans (Schedules.cs) checked
       and the demand they make measured against the surveys; phase 3: the meso (Meso.cs) run over each race's day; phase 4: the micro
       level (Micro.cs, Driver.cs) round pretend players and the visible faults (MicroDay.cs); phase 5: the game's own path (TrafficLive.cs,
       TrafficParking.cs) frame by frame round a pretend player (GameDay.cs). See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
