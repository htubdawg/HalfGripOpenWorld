<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HalfGripTools</AssemblyName>
    <NoWarn>CS0067</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)../../../HalfGripRefs/game</GameDir>
    <Managed>$(GameDir)/HalfGrip_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Managed)/*.dll" Exclude="$(Managed)/mscorlib.dll;$(Managed)/netstandard.dll;$(Managed)/System*.dll" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" />
  </ItemGroup>
</Project>
