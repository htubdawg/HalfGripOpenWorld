<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the deer's room (DeerRoom.cs: reactions and kills settled by the host) on pretend machines over a pretend network. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../OpenWorld/src/DeerRoom.cs" />
    <Compile Include="../../OpenWorld/src/DeerKills.cs" />
    <Compile Include="../../OpenWorld/src/Rng.cs" />
  </ItemGroup>
</Project>
